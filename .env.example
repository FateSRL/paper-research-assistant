# LLM_PROVIDER and EMBEDDING_* are read by this project; HelloAgents does not automatically read all of them.
LLM_PROVIDER=deepseek
LLM_MODEL_ID=deepseek-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=30

EMBEDDING_BACKEND=dashscope
EMBEDDING_MODEL=qwen3.7-text-embedding
# 从百炼华北 2（北京）的 API Key 页面复制，只填到本机 .env，不填这个示例文件。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIMENSION=1024

# 可选：配置模型及地址后启用重排；地址中的业务空间 ID 替换为自己的北京业务空间。
RERANK_MODEL=
RERANK_BASE_URL=
# 模型 qwen3-rerank；地址 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-api/v1
# 留空复用 EMBEDDING_API_KEY；密钥只填写到本机 .env。
RERANK_API_KEY=
RERANK_TIMEOUT=30

# MinerU 官方精准解析 API：在本机 .env 填写 API 管理页面创建的 Token，不加 Bearer 前缀。
# 调用：python -X utf8 -m scripts.parse_mineru_api <PDF路径>
MINERU_API_TOKEN=
